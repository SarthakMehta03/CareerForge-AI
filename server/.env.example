PORT=5000
MONGO_URI=mongodb://localhost:27017/careerforge
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION
# Required for Google Sign-In ("Continue with Google")
# ==============================================================================
# Google OAuth 2.0 Web Client ID generated in Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Initial Administrator Bootstrap (Optional)
# Specify an email to promote to admin on startup if no admin accounts exist
FIRST_ADMIN_EMAIL=admin@careerforge.ai

# ==============================================================================
# EMAIL DELIVERY & SMTP CONFIGURATION (GMAIL / CUSTOM SMTP)
# Used for sending Welcome Emails (with unique Account ID) to new Google users
# and Password Reset links for email/password users.
# ==============================================================================
# 
# OPTION 1: GMAIL CONFIGURATION (Recommended for personal Gmail accounts)
# Step 1: Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# Step 2: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#         - In "App name", enter "CareerForge-AI" and click Create.
#         - Copy the generated 16-character code (e.g. abcd efgh ijkl mnop).
#         (Note: Your standard personal Google account password will be rejected by Google SMTP!)
# Step 3: Fill in these lines in server/.env:
SMTP_SERVICE=gmail
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_16_character_app_password

# OPTION 2: GENERIC / ENTERPRISE SMTP (SendGrid, Mailtrap, Brevo, AWS SES)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
# FROM_EMAIL="CareerForge-AI" <no-reply@careerforge.ai>

# Client URL (for password reset links) - CLIENT_URL or FRONTEND_URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Password Reset & Login OTP Rate Limiting & Cooldown
OTP_COOLDOWN_SECONDS=60
RESET_COOLDOWN_SECONDS=60
RESET_MAX_ATTEMPTS=5
RESET_WINDOW_MINUTES=15

# Google Gemini Free-Tier Configuration
# Approved models: gemini-3.8-flash, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_API_KEY=your_secret_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AI_ENABLED=false
GEMINI_MAX_QUESTIONS_PER_REQUEST=10
GEMINI_MAX_REQUESTS_PER_USER_PER_DAY=5
GEMINI_MAX_GLOBAL_REQUESTS_PER_DAY=50
GEMINI_COOLDOWN_SECONDS=15

# Aptitude Daily Application Credit System
APTITUDE_DAILY_CREDIT_ALLOWANCE=100
APTITUDE_CREDIT_COST_PER_QUESTION=2
APTITUDE_BASE_CREDIT_COST=0
APTITUDE_RESERVATION_EXPIRY_SECONDS=180
